<%- include('../../partials/header') %>
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h1 class="mb-4">
                    <%= title %>
                </h1>
                <% if (users && users.length> 0) { %>
                    <div class="users-list">
                        <% users.forEach(listUser=> { %>
                            <% /* Calculate permissions for this user card. `user`=current logged-in user (from session
                                / locals) `listUser`=user being rendered in this loop */ const currentUser=(typeof
                                isLoggedIn !=="undefined" && isLoggedIn) ? user : null; const canEdit=currentUser &&
                                (currentUser.user_id===listUser.user_id || currentUser.roleName==="admin" ); const
                                canDelete=currentUser && currentUser.roleName==="admin" && currentUser.user_id
                                !==listUser.user_id; %>
                                <div class="card">
                                    <div class="card-body">
                                        <h3 class="card-title">
                                            <%= listUser.first_name %>
                                                <%= listUser.last_name %>
                                        </h3>
                                        <p class="card-text text-muted">
                                            <%= listUser.email %>
                                        </p>

                                        <% if (canEdit || canDelete) { %>
                                            <% if (canEdit) { %>
                                                <a href="/register/<%= listUser.user_id %>/edit"
                                                    class="btn btn-outline-primary btn-sm">Edit Profile</a>
                                                <% } %>
                                                    <form method="POST"
                                                        action="/register/<%= listUser.user_id %>/delete"
                                                        style="display: inline;">
                                                        <button type="submit"
                                                            onclick="return confirm('Are you sure you want to delete this user?')"
                                                            class="btn btn-outline-secondary btn-sm">
                                                            Delete
                                                        </button>
                                                    </form>
                                                    <% } %>
                                    </div>
                                </div>
                                <% }); %>
                    </div>
                    <% } else { %>
                        <p class="no-users">No users registered yet.</p>
                        <% } %>
            </div>
        </div>
    </main>
    <%- include('../../partials/footer') %>