<%- include('../../partials/dashboard/header') %>
    <div class="table-responsive"></div>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">
                    <a href="/jobs/?sort=jobId" class="<%= currentSort === 'jobId' ? 'active' : '' %>">#</a>
                </th>
                <th scope="col">
                    <a href="/jobs/?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
                </th>
                <th scope="col">
                    Company
                </th>
                <th scope="col">
                    URL
                </th>
                <th scope="col">
                    City
                </th>
                <th scope="col">
                    <a href="/jobs/?sort=state" class="<%= currentSort === 'state' ? 'active' : '' %>">State</a>
                </th>
                <th scope="col">
                    <a href="/jobs/?sort=minSalary" class="<%= currentSort === 'minSalary' ? 'active' : '' %>">Min
                        Salary</a>
                </th>
                <th scope="col">
                    <a href="/jobs/?sort=maxSalary" class="<%= currentSort === 'maxSalary' ? 'active' : '' %>">Max
                        Salary</a>
                </th>
                <th scope="col">
                    <a href="/jobs/?sort=datePosted" class="<%= currentSort === 'datePosted' ? 'active' : '' %>">Date
                        Posted</a>
                </th>
                <th scope="col">
                    <a href="/jobs" class="<%= currentSort === 'lastChanged' ? 'active' : '' %>">Date Changed</a>
                </th>
                <th scope="col">
                    <a href="/jobs/?sort=status" class="<%= currentSort === 'status' ? 'active' : '' %>">Status</a>
                </th>
                <th scope="col">
                    <a href="/jobs/?sort=type" class="<%= currentSort === 'type' ? 'active' : '' %>">Type</a>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">Id</th>
                <td>Title</td>
                <td>Company</td>
                <td>URL</td>
                <td>City</td>
                <td>State</td>
                <td>Min</td>
                <td>Max</td>
                <td>Date posted</td>
                <td>Last changed</td>
                <td>Status</td>
                <td>Type</td>
            </tr>
            <% Object.values(jobs).forEach(job=> { %>
                <tr>
                    <th scope="row">
                        <%= job.id %>
                    </th>
                    <td>
                        <a href="/jobs/<%= job.id %>">
                            <%= job.title %>
                        </a>
                    </td>
                    <td>
                        <%= job.company %>
                    </td>
                    <td>
                        <a href="<%= job.url %>">
                            <%= job.shortenedUrl %>
                        </a>
                    </td>
                    <td>
                        <%= job.city %>
                    </td>
                    <td>
                        <%= job.state %>
                    </td>
                    <td>
                        <%= job.minSalary %>
                    </td>
                    <td>
                        <%= job.maxSalary %>
                    </td>
                    <td>
                        <%= job.datePosted %>
                    </td>
                    <td>
                        <%= job.lastChanged %>
                    </td>
                    <td>
                        <%= job.status %>
                    </td>
                    <td>
                        <%= job.type %>
                    </td>
                </tr>
                <% }); %>
        </tbody>
    </table>
    </div>
    <%- include('../../partials/dashboard/footer') %>