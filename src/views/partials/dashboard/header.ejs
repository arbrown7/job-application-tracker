<%- include('../header') %>
    <main>
        <div class="d-flex h-100 text-center text-white">
            <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
                <div class="px-3">
                    <h1>Welcome <%= userName %>
                    </h1>
                    <p class="lead">Let's hit the ground running, today.</p>
                </div>
            </div>
        </div>
        <div class="navbar navbar-expand-md navbar-light bg-light justify-content-md-center">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a href="/jobs" class="nav-link <%= !currentType ? 'active' : '' %>">All Jobs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentType === 'application' ? 'active' : '' %>" href="/jobs?type=application">Applications</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentType === 'suggestion' ? 'active' : '' %>" href="/jobs?type=suggestion">Suggestions</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentType === 'potential' ? 'active' : '' %>" href="/jobs?type=potential">Potentials</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentType === 'newJob' ? 'active' : '' %>" href="/jobs/new">Add a Job</a>
                </li>                
            </ul>
        </div>