<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <%- renderStyles() %>
        <%- renderScripts() %>
            <% if (NODE_ENV.includes('dev')) { %>
                <script>
                    // Get the current hostname and port from the browser
                    const host = window.location.hostname;
                    const currentPort = window.location.port;

                    // Calculate WebSocket port (current port + 1)
                    const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;

                    // Create WebSocket connection using dynamic hostname and port
                    const ws = new WebSocket(`ws://${host}:${wsPort}`);
                    ws.onclose = () => {
                        setTimeout(() => location.reload(), 2000);
                    };
                </script>
                <% } %>
</head>

<body>
    <header>
        <nav class="d-flex justify-content-between align-items-center mb-5 px-4 pt-3">
            <a class="navbar-brand fw-500 text-decoration-none text-dark" href="/">job-application-tracker</a>
            <div class="d-flex gap-2">
                <% if (isSeeker) { %>
                    <a class="btn btn-sm btn-outline-secondary" href="/jobs">Dashboard</a>
                <% } %>
                <% if (isSupporter) { %>
                    <a class="btn btn-sm btn-outline-secondary" href="/jobs/suggestion">Suggest a Job</a>
                <% } %>
                <% if (isAdmin) { %>
                    <a class="btn btn-sm btn-outline-secondary" href="/admin">Admin</a>
                <% } %>
                <% if (isLoggedIn) { %>
                    <a class="btn btn-sm btn-outline-secondary" href="/registration/profile">Profile</a>
                    <a class="btn btn-sm btn-outline-secondary" href="/logout">Logout</a>
                <% } else {%>
                    <a href="/login" class="btn btn-sm btn-outline-secondary">Log in</a>
                    <a href="/register" class="btn btn-sm btn-outline-secondary">Sign up</a>
                </div>
            <% } %>
        </nav>
    </header>

    <% const messages=flash(); const hasMessages=Object.values(messages).some(arr=> arr.length > 0);
        %>

        <% if (hasMessages) { %>
            <div class="flash-messages">
                <% Object.keys(messages).forEach(type=> { %>
                    <% messages[type].forEach(message=> { %>
                        <div class="flash <%= type %>">
                            <%= message %>
                        </div>
                        <% }); %>
                            <% }); %>
            </div>
            <% } %>