<%- include('../partials/dashboard/header') %>
<div class="container" style="max-width: 860px; padding: 2rem 1.5rem;">
    <!-- HTML file styled mainly with AI -->

    <!-- Sort pills -->
    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
      <span style="font-size:12px; color:#888; margin-right: 4px;">Sort by</span>
      <a href="/jobs?type=<%= currentType %>&sort=jobId" class="sort-btn <%= currentSort === 'jobId' ? 'active' : '' %> text-decoration-none">ID</a>
      <a href="/jobs?type=<%= currentType %>&sort=title" class="sort-btn <%= currentSort === 'title' ? 'active' : '' %> text-decoration-none">Title</a>
      <a href="/jobs?type=<%= currentType %>&sort=state" class="sort-btn <%= currentSort === 'state' ? 'active' : '' %> text-decoration-none">State</a>
      <a href="/jobs?type=<%= currentType %>&sort=datePosted" class="sort-btn <%= currentSort === 'datePosted' ? 'active' : '' %> text-decoration-none">Date posted</a>
      <a href="/jobs?type=<%= currentType %>&sort=lastChanged" class="sort-btn <%= currentSort === 'lastChanged' ? 'active' : '' %> text-decoration-none">Date changed</a>
      <a href="/jobs?type=<%= currentType %>&sort=status" class="sort-btn <%= currentSort === 'status' ? 'active' : '' %> text-decoration-none">Status</a>
    </div>
<% if (jobs && jobs.length> 0) { %>
    <div class="d-flex flex-column gap-3">
    <% Object.values(jobs).forEach(job=> { %>
        <div class="job-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <p class="mb-0" style="font-size:15px; font-weight:500;"><%= job.title %></p>
                
                <p class="text-secondary mb-0" style="font-size:13px;">
                    <%= job.company %> 
                    <% if(job.city && job.state) { %>
                        &mdash; <%= job.city %>, <%= job.state %>
                    <% } else if(job.city) { %>
                        <%= job.city %>
                    <% } else if(job.state) { %>
                        <%= job.state %>
                    <% } %>
                </p>

            </div>
            <div class="d-flex gap-2">
                <span class="badge-pill"><%= job.status %></span>
                <span class="badge-pill"><%= job.type %></span>
            </div>
            </div>
            <div class="border-top pt-2 d-flex justify-content-between align-items-center">
            <div class="row g-2" style="width: 420px;">

                <% if(job.minSalary && job.maxSalary) { %>
                    <div class="col-4"><p class="meta-label">Salary range</p><p class="meta-value">$<%= job.minSalary %> – $<%= job.maxSalary %></p></div>
                <% } else if(job.minSalary) { %>
                    <div class="col-4"><p class="meta-label">Salary</p><p class="meta-value">$<%= job.minSalary %></p></div>
                <% } else if(job.maxSalary){ %>
                    <div class="col-4"><p class="meta-label">Salary</p><p class="meta-value">$<%= job.maxSalary %></p></div>
                <% } %>

                <div class="col-4"><p class="meta-label">Posted</p><p class="meta-value"><%= job.datePosted %></p></div>
                
                <% if(job.contactName && job.contactEmail) { %>
                    <div class="col-4"><p class="meta-label">Contact</p><a href="mailto:<%= job.contactEmail %>" class="meta-value"><%= job.contactName %></a></div>
                <% } else if(job.contactName) { %>
                    <div class="col-4"><p class="meta-label">Contact</p><p class="meta-value"><%= job.contactName %></p></div>
                <% } else if(job.contactName) { %>
                    <div class="col-4"><p class="meta-label">Contact</p><p class="meta-value"><%= job.contactEmail %></p></div>
                <% } %>
            </div>
            <div class="d-flex gap-2">
                <a href="/jobs/<%= job.id %>/edit" class="action-btn">Edit</a>
                <form action="/jobs/<%= job.id %>/delete" method="POST">
                    <button type="submit" class="action-btn danger">Delete</button>
                </form>
            </div>
            </div>
        </div>
      <% }); %>
<% } else { %>
    <p class="no-jobs">No <%= currentType %>s logged yet.</p>
<% } %>
    </div>

  </div>
<%- include('../partials/dashboard/footer') %>